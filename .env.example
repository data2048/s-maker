# s-maker configuration.
# On the server: deploy.sh copies this file to <deploy root>/.env on first run; fill it in there.
# Do NOT put quotes around values: docker --env-file keeps them literally.
# Never commit the real .env (the repo is public).

# Public HTTPS address of the app as the browser sees it, without a trailing slash.
# Example: https://music.example.com
PUBLIC_URL=

# Username of the first admin account. On first start a one-time setup link is printed in the logs.
ADMIN_USERNAME=

# Address of your reverse proxy as seen from inside the container, so the real client IP
# from X-Forwarded-For is trusted (needed for rate limiting and audit logs).
# Proxy on the same host connecting to 127.0.0.1:44566 -> usually the Docker bridge gateway: 172.17.0.1
# Several values: comma separated. Empty = trust nobody.
TRUST_PROXY=

# Host address where port 44566 is published (read by deploy.sh, not by the app).
# 127.0.0.1 when the reverse proxy runs on the same host, 0.0.0.0 when it runs elsewhere.
BIND_ADDRESS=127.0.0.1

# OpenRouter key for the agent (https://openrouter.ai/keys). Set a credit limit on the key itself too.
OPENROUTER_API_KEY=

# Models (ids from https://openrouter.ai/models). The admin can change them in the app.
MODEL_FAST=deepseek/deepseek-v4.1-flash
MODEL_STRONG=deepseek/deepseek-v4-pro-0813
# Tried when the others fail; empty for none.
MODEL_FALLBACK=z-ai/glm-5.3

# Spending limits in USD over the last 7 days. The admin can change them in the app.
AGENT_USER_WEEKLY_USD=3
AGENT_GLOBAL_WEEKLY_USD=10

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
